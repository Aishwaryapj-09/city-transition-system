// ============================================================
// City Transition System - Jenkins DevSecOps Pipeline
// Flow: Build -> Test -> Scan -> Docker -> Kubernetes -> Monitor
//
// Performance is observed continuously via Prometheus + Grafana.
// Custom performance-test.js and k6 load-test stages have been removed.
//
// Every artifact lands in ONE folder: devsecops-reports/
// (lint, tests, coverage HTML, sonar, audit, docker, k8s, ansible,
//  postman, monitoring snapshots, per-endpoint Prometheus probes,
//  and one summarised HTML dashboard).
// ============================================================

pipeline {
    agent any

    environment {
        BACKEND_IMAGE  = "aishwaryapj09/city-transition-backend"
        FRONTEND_IMAGE = "aishwaryapj09/city-transition-frontend"
        TAG            = "latest"
        KUBECONFIG     = "C:\\Users\\LENOVO\\.kube\\config"
        SONARQUBE_ENV  = "sonarqube-server"
    }

    stages {

        // ----------- 0. Workspace ---------------------------------------

        stage('Checkout') {
            steps {
                deleteDir()
                checkout scm
                bat 'if not exist devsecops-reports mkdir devsecops-reports'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
                dir('backend')  { bat 'npm install' }
                dir('frontend') { bat 'npm install' }
            }
        }

        // ----------- 1. Static analysis ---------------------------------

        stage('ESLint') {
            steps {
                dir('backend') {
                    bat 'npm run lint -- --format json --output-file ..\\devsecops-reports\\backend-eslint-report.json'
                }
                dir('frontend') {
                    bat 'npm run lint -- --format json --output-file ..\\devsecops-reports\\frontend-eslint-report.json'
                }
            }
        }

        // ----------- 2. Tests + coverage --------------------------------

        stage('Unit Tests + Coverage') {
            steps {
                dir('backend') {
                    bat 'npm run coverage -- --json --outputFile=..\\devsecops-reports\\backend-coverage-test-report.json'
                }
                // Copy the HTML coverage report into the single reports folder
                // so the user finds everything in one place.
                bat 'if exist backend\\coverage xcopy /E /I /Y backend\\coverage devsecops-reports\\coverage-html'
            }
        }

        stage('Integration Tests') {
            steps {
                dir('backend') {
                    bat 'npm run test:integration -- --json --outputFile=..\\devsecops-reports\\backend-integration-test-report.json'
                }
            }
        }

        // ----------- 3. SonarQube --------------------------------------

        stage('SonarQube Static Analysis') {
            steps {
                withSonarQubeEnv("${SONARQUBE_ENV}") {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        dir('backend') {
                            bat """
                            npx sonar-scanner -Dsonar.login=%SONAR_TOKEN% > ..\\devsecops-reports\\sonarqube-scanner-report.txt 2>&1
                            type ..\\devsecops-reports\\sonarqube-scanner-report.txt
                            """
                        }
                    }
                }
            }
        }

        // ----------- 4. Dependency security ----------------------------

        stage('npm audit') {
            steps {
                // Always succeed; the report is the evidence.
                bat 'npm audit --omit=dev --audit-level=high --json > devsecops-reports\\root-npm-audit-report.json || exit 0'
                dir('backend')  { bat 'npm audit --audit-level=high --json > ..\\devsecops-reports\\backend-npm-audit-report.json || exit 0' }
                dir('frontend') { bat 'npm audit --audit-level=high --json > ..\\devsecops-reports\\frontend-npm-audit-report.json || exit 0' }
            }
        }

        // ----------- 5. Docker ------------------------------------------

        stage('Docker Build') {
            steps {
                bat "docker build --no-cache -t %BACKEND_IMAGE%:%TAG%  ./backend"
                bat "docker build --no-cache -t %FRONTEND_IMAGE%:%TAG% ./frontend"
                bat 'docker image inspect %BACKEND_IMAGE%:%TAG% %FRONTEND_IMAGE%:%TAG% > devsecops-reports\\docker-image-report.json'
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-pass',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    bat """
                    echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin
                    docker push %BACKEND_IMAGE%:%TAG%
                    docker push %FRONTEND_IMAGE%:%TAG%
                    docker logout
                    """
                }
            }
        }

        // ----------- 6. Ansible / Kubernetes deploy --------------------

        stage('Ansible / Kubernetes Deploy') {
            steps {
                // Prefer Ansible IaC; fall back to kubectl apply if Ansible is missing.
                bat """
                set DEPLOY_EXIT=0
                where ansible-playbook >nul 2>nul
                if %ERRORLEVEL% EQU 0 goto run_ansible
                goto run_kubectl

:run_ansible
                echo Using Ansible IaC. > devsecops-reports\\deployment-report.txt
                ansible-playbook -i ansible/inventory.ini ansible/deploy.yml >> devsecops-reports\\deployment-report.txt 2>&1
                set DEPLOY_EXIT=%ERRORLEVEL%
                goto deploy_done

:run_kubectl
                echo ansible-playbook not found. Falling back to kubectl. > devsecops-reports\\deployment-report.txt
                kubectl config use-context docker-desktop      >> devsecops-reports\\deployment-report.txt 2>&1
                kubectl apply -f k8s/ --validate=false         >> devsecops-reports\\deployment-report.txt 2>&1
                kubectl rollout restart deployment/backend     >> devsecops-reports\\deployment-report.txt 2>&1
                kubectl rollout restart deployment/frontend    >> devsecops-reports\\deployment-report.txt 2>&1
                kubectl rollout status deployment/backend          --timeout=180s >> devsecops-reports\\deployment-report.txt 2>&1
                kubectl rollout status deployment/frontend         --timeout=180s >> devsecops-reports\\deployment-report.txt 2>&1
                kubectl rollout status deployment/prometheus       --timeout=180s >> devsecops-reports\\deployment-report.txt 2>&1
                kubectl rollout status deployment/blackbox-exporter --timeout=180s >> devsecops-reports\\deployment-report.txt 2>&1
                kubectl rollout status deployment/grafana          --timeout=180s >> devsecops-reports\\deployment-report.txt 2>&1
                set DEPLOY_EXIT=%ERRORLEVEL%

:deploy_done
                type devsecops-reports\\deployment-report.txt
                exit /b %DEPLOY_EXIT%
                """
            }
        }

        stage('Verify Kubernetes Resources') {
            steps {
                bat """
                kubectl get deployments -o wide  > devsecops-reports\\kubernetes-verification-report.txt 2>&1
                kubectl get daemonsets  -o wide >> devsecops-reports\\kubernetes-verification-report.txt 2>&1
                kubectl get pods        -o wide >> devsecops-reports\\kubernetes-verification-report.txt 2>&1
                kubectl get services    -o wide >> devsecops-reports\\kubernetes-verification-report.txt 2>&1
                type devsecops-reports\\kubernetes-verification-report.txt
                """
            }
        }

        // ----------- 7. API smoke tests --------------------------------

        stage('Postman Smoke Tests') {
            steps {
                bat 'npm run api:test:deployed'
            }
        }

        // ----------- 8. Generate route metrics + 9. Monitoring check ---

        stage('Hit Every Endpoint (creates route metrics)') {
            steps {
                // Calling every public endpoint once produces per-route
                // labels in city_transition_http_requests_total and in the
                // latency histogram - the Grafana dashboard needs that.
                bat 'npm run reports:endpoints'
            }
        }

        stage('Prometheus and Grafana Monitoring Check') {
            steps {
                // Replaces the old performance-test.js / k6 stages.
                // Verifies monitoring is healthy and EVERY endpoint is
                // being probed by Blackbox Exporter (not just one).
                bat """
                set REPORT=devsecops-reports\\monitoring-health-report.txt
                echo ============================================================ > %REPORT%
                echo City Transition System - Monitoring Health Check            >> %REPORT%
                echo Stack: Prometheus + Grafana + cAdvisor + Node Exporter      >> %REPORT%
                echo ============================================================ >> %REPORT%
                echo. >> %REPORT%

                echo [1] Prometheus       >> %REPORT%
                curl -sf http://localhost:30090/-/healthy >> %REPORT% 2>&1 && echo     [OK] Prometheus is healthy >> %REPORT% || echo     [WARN] Prometheus not reachable >> %REPORT%

                echo. >> %REPORT%
                echo [2] Grafana          >> %REPORT%
                curl -sf http://localhost:30300/api/health >> %REPORT% 2>&1 && echo     [OK] Grafana is reachable >> %REPORT% || echo     [WARN] Grafana not reachable >> %REPORT%

                echo. >> %REPORT%
                echo [3] Backend /metrics >> %REPORT%
                curl -sf http://localhost:30008/metrics -o devsecops-reports\\prometheus-metrics-snapshot.txt 2>&1 && echo     [OK] backend /metrics reachable >> %REPORT% || echo     [WARN] backend /metrics not reachable >> %REPORT%

                echo. >> %REPORT%
                echo [4] Backend metric families present >> %REPORT%
                call :check_metric "city_transition_up"                                "backend up gauge"
                call :check_metric "city_transition_http_requests_total"               "request count"
                call :check_metric "city_transition_http_request_duration_seconds"     "response time / latency histogram"
                call :check_metric "city_transition_http_errors_total"                 "4xx/5xx error counter"
                call :check_metric "city_transition_process_resident_memory_bytes"     "memory"
                call :check_metric "city_transition_process_cpu_seconds_total"         "CPU"

                echo. >> %REPORT%
                echo [5] Route labels present for every endpoint >> %REPORT%
                call :check_metric "route=\\\"/api/listings\\\""         "/api/listings"
                call :check_metric "route=\\\"/api/accommodation\\\""    "/api/accommodation"
                call :check_metric "route=\\\"/api/nearby\\\""           "/api/nearby"
                call :check_metric "route=\\\"/api/language-helper\\\""  "/api/language-helper"
                call :check_metric "route=\\\"/health\\\""               "/health"

                echo. >> %REPORT%
                echo [6] Blackbox per-endpoint probes (probe_success):  >> %REPORT%
                curl -sf "http://localhost:30090/api/v1/query?query=probe_success%%7Bjob%%3D%%22blackbox-http%%22%%7D" > devsecops-reports\\prometheus-endpoints-raw.json 2>&1
                if exist devsecops-reports\\prometheus-endpoints-raw.json (
                    echo     (raw query saved to prometheus-endpoints-raw.json) >> %REPORT%
                ) else (
                    echo     [WARN] Could not query Prometheus for probe_success >> %REPORT%
                )

                echo. >> %REPORT%
                echo Performance visibility is now CONTINUOUS in Grafana. >> %REPORT%
                echo Jenkins no longer runs standalone performance scripts. >> %REPORT%
                type %REPORT%
                exit /b 0

:check_metric
                findstr /C:%1 devsecops-reports\\prometheus-metrics-snapshot.txt > nul 2>&1
                if errorlevel 1 (
                    echo     [WARN] %~2 missing  >> %REPORT%
                ) else (
                    echo     [OK]   %~2 present >> %REPORT%
                )
                goto :eof
                """
            }
        }

        // ----------- 10. Generate visual DevSecOps dashboard -----------

        stage('Generate Visual DevSecOps Report') {
            steps {
                // Produces devsecops-reports/devsecops-dashboard.html -
                // a single-page summary the user opens in the browser.
                bat 'npm run reports:dashboard'
            }
        }

        stage('Pipeline Summary') {
            steps {
                echo "======================================================"
                echo " City Transition DevSecOps Pipeline complete"
                echo " All reports:    devsecops-reports/"
                echo " Visual summary: devsecops-reports/devsecops-dashboard.html"
                echo " Coverage HTML:  devsecops-reports/coverage-html/index.html"
                echo "------------------------------------------------------"
                echo " Continuous monitoring (Prometheus + Grafana):"
                echo "   - response time, latency, throughput, request count"
                echo "   - 4xx/5xx error rate"
                echo "   - CPU, memory, container/node usage"
                echo "   - per-endpoint uptime via Blackbox Exporter"
                echo "======================================================"
            }
        }
    }

    post {
        always {
            // ONE folder, archived. The user opens devsecops-dashboard.html.
            archiveArtifacts artifacts: 'devsecops-reports/**', allowEmptyArchive: true
            echo 'Pipeline finished. Open devsecops-reports/devsecops-dashboard.html'
        }
        success {
            echo 'PIPELINE PASSED. Continuous monitoring is live.'
        }
        failure {
            echo 'PIPELINE FAILED. Review devsecops-reports/ for details.'
        }
    }
}
