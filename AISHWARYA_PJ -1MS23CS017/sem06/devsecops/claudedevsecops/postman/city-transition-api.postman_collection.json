{
  "info": {
    "name": "City Transition System API",
    "description": "Postman collection for the City Transition System backend. Organised by feature. Works both against a local backend (http://localhost:5000) and against the Docker/Kubernetes deployment (NodePort 30008) — switch environments to choose.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "ct-collection-001"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Default baseUrl if no environment is selected.",
          "if (!pm.environment.get('baseUrl')) { pm.environment.set('baseUrl', 'http://localhost:5000'); }"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" }
  ],
  "item": [
    {
      "name": "Health Checks",
      "description": "Basic liveness and readiness probes.",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Body is JSON', () => pm.response.to.be.json);"
            ] } }
          ]
        },
        {
          "name": "GET /metrics",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/metrics", "host": ["{{baseUrl}}"], "path": ["metrics"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Exposes city_transition_ metrics', () => pm.expect(pm.response.text()).to.include('city_transition_'));"
            ] } }
          ]
        }
      ]
    },

    {
      "name": "Authentication",
      "description": "Login and token retrieval. Successful login stores the token in {{authToken}}.",
      "item": [
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@city.test\",\n  \"password\": \"demo1234\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200 or 401', () => pm.expect([200,401]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  const j = pm.response.json();",
              "  if (j && j.token) { pm.environment.set('authToken', j.token); }",
              "}"
            ] } }
          ]
        },
        {
          "name": "POST /api/auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo@city.test\",\n  \"password\": \"demo1234\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200, 201, or 409', () => pm.expect([200,201,409]).to.include(pm.response.code));"
            ] } }
          ]
        }
      ]
    },

    {
      "name": "Listings",
      "description": "Owner / property listings.",
      "item": [
        {
          "name": "GET /api/listings",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/listings", "host": ["{{baseUrl}}"], "path": ["api","listings"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));"
            ] } }
          ]
        },
        {
          "name": "GET /api/listings/:id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/listings/sample-id", "host": ["{{baseUrl}}"], "path": ["api","listings","sample-id"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200 or 404', () => pm.expect([200,404]).to.include(pm.response.code));"
            ] } }
          ]
        }
      ]
    },

    {
      "name": "Accommodation",
      "description": "Accommodation finder endpoints.",
      "item": [
        {
          "name": "GET /api/accommodation",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/accommodation?city=Bengaluru",
              "host": ["{{baseUrl}}"], "path": ["api","accommodation"],
              "query": [{ "key": "city", "value": "Bengaluru" }]
            }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));"
            ] } }
          ]
        }
      ]
    },

    {
      "name": "Nearby",
      "description": "Find nearby services / amenities.",
      "item": [
        {
          "name": "GET /api/nearby",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/nearby?city=Bengaluru&type=restaurant",
              "host": ["{{baseUrl}}"], "path": ["api","nearby"],
              "query": [
                { "key": "city", "value": "Bengaluru" },
                { "key": "type", "value": "restaurant" }
              ]
            }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Responds under 2s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
            ] } }
          ]
        }
      ]
    },

    {
      "name": "Language Helper",
      "description": "Local language helper / translation API.",
      "item": [
        {
          "name": "GET /api/language-helper",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/language-helper?text=hello&to=ta",
              "host": ["{{baseUrl}}"], "path": ["api","language-helper"],
              "query": [
                { "key": "text", "value": "hello" },
                { "key": "to",   "value": "ta" }
              ]
            }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));"
            ] } }
          ]
        }
      ]
    },

    {
      "name": "Admin",
      "description": "Admin verification endpoints. Requires an admin token in {{authToken}}.",
      "item": [
        {
          "name": "GET /api/auth/admin/pending",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/admin/pending", "host": ["{{baseUrl}}"], "path": ["api","auth","admin","pending"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status is 200, 401, or 403', () => pm.expect([200,401,403]).to.include(pm.response.code));"
            ] } }
          ]
        }
      ]
    }
  ]
}
