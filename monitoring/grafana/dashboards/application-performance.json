      "targets": [ { "expr": "max(city_transition_process_uptime_seconds)", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "stat",
      "title": "Active Requests",
      "id": 3,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [ { "expr": "sum(city_transition_http_active_requests)", "refId": "A" } ]
