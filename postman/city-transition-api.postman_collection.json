{
  "info": {
    "_postman_id": "9a93f037-6e7f-4f08-9a16-1b6b9b6f9b41",
    "name": "City Transition System API",
    "description": "Postman/Newman tests for DevSecOps API validation, deployment smoke checks, and existing feature regression.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "testUserEmail",
      "value": ""
    },
    {
      "key": "testUserPassword",
      "value": "Password123!"
    }
  ],
  "item": [
    {
      "name": "CD Smoke",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('backend reports OK', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('OK');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Prometheus metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "metrics"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('exposes Prometheus format metrics', function () {",
                  "  pm.expect(pm.response.text()).to.include('city_transition_up 1');",
                  "  pm.expect(pm.response.text()).to.include('city_transition_http_requests_total');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Nearby validation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/nearby?lat=12.9716&lng=77.5946&type=mall",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "nearby"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "12.9716"
                },
                {
                  "key": "lng",
                  "value": "77.5946"
                },
                {
                  "key": "type",
                  "value": "mall"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('rejects unsupported nearby type', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().message).to.include('type must be one of');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Language helper validation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/language-helper",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "language-helper"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('requires a place value', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().message).to.eql('place is required');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Feature API Regression",
      "item": [
        {
          "name": "Register owner user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('testUserEmail', `newman.${Date.now()}@example.com`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('creates a test owner user', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().message).to.eql('User registered successfully');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Newman Owner\",\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\",\n  \"role\": \"owner\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login owner user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('logs in and stores JWT token', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('authToken', body.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Protected auth route",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/protected",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "protected"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('allows authenticated user', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().message).to.eql('Protected data');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Public listings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/listings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "listings"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns verified listings array', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Accommodation validation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accommodation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accommodation"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('requires location query', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().message).to.eql('Location is required');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
