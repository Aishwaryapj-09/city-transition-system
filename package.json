{
  "name": "city-transition-system",
  "private": true,
  "scripts": {
    "api:test": "newman run postman/city-transition-api.postman_collection.json -e postman/local.postman_environment.json",
    "api:test:smoke": "newman run postman/city-transition-api.postman_collection.json -e postman/local.postman_environment.json --folder \"CD Smoke\"",
    "api:test:deployed": "newman run postman/city-transition-api.postman_collection.json -e postman/local.postman_environment.json --folder \"CD Smoke\" --env-var baseUrl=http://localhost:30008",
    "perf:test": "node tools/performance-test.js",
    "perf:test:deployed": "node tools/performance-test.js http://localhost:30008"
  },
  "devDependencies": {
    "newman": "^6.2.1",
    "sonar-scanner": "^3.1.0"
  }
}
